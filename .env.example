# ---- Core ----
APP_URL=http://localhost:3000

# ---- Database / Redis (docker-compose defaults) ----
DATABASE_URL=postgresql://pixelforge:pixelforge@localhost:5432/pixelforge
REDIS_URL=redis://localhost:6379

# ---- Auth (Better Auth) ----
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Storage (S3 API: SeaweedFS locally, Cloudflare R2 in prod) ----
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_BUCKET_UPLOADS=pixelforge-uploads
S3_BUCKET_PUBLIC=pixelforge-public
PUBLIC_ASSET_BASE_URL=http://localhost:8333/pixelforge-public

# ---- AI: Google Gemini only (mock = offline dev/tests) ----
AI_PROVIDER=mock
GEMINI_API_KEY=
# Optional model overrides (defaults live in packages/ai)
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# ---- Stock content ----
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ---- Email / observability / analytics (optional in dev) ----
# SMTP (any provider). Empty SMTP_HOST = emails are logged to the console in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PixelForge <no-reply@example.com>

# ---- Billing (optional; without keys, paid plans show a waitlist) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring prices per plan/interval (packages/shared/src/plans.ts PlanId). Unset = that plan/interval
# isn't purchasable yet and the pricing page falls back to the waitlist for it.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
# One-time prices for credit bundles (apps/web/lib/billing/bundles.ts).
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_PRO=
STRIPE_PRICE_CREDITS_STUDIO=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
