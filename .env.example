# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Database / Redis (docker-compose defaults) ----
DATABASE_URL=postgresql://pixelforge:pixelforge@localhost:5432/pixelforge
REDIS_URL=redis://localhost:6379

# ---- Auth (Better Auth) ----
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Storage (S3 API: MinIO locally, Cloudflare R2 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=pixelforge
S3_SECRET_ACCESS_KEY=pixelforge-secret
S3_BUCKET_UPLOADS=pixelforge-uploads
S3_BUCKET_PUBLIC=pixelforge-public
PUBLIC_ASSET_BASE_URL=http://localhost:9000/pixelforge-public

# ---- AI (mock | replicate) ; text: mock | anthropic ----
AI_IMAGE_PROVIDER=mock
AI_TEXT_PROVIDER=mock
REPLICATE_API_TOKEN=
ANTHROPIC_API_KEY=

# ---- Stock content ----
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ---- Email / observability / analytics (optional in dev) ----
RESEND_API_KEY=
EMAIL_FROM=PixelForge <no-reply@example.com>
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
